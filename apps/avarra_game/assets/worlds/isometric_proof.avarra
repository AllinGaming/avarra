            "avarra.objective.item_turn_in": {
              "schemaVersion": 1,
              "requiredItemId": "relay.core",
              "completionFlagKey": "signal.transmitted",
              "completionLabel": "Signal transmitted"
            },
            "avarra.story.mission_narrative": {
              "schemaVersion": 1,
              "title": "Ashfall's Last Signal",
              "openingText": "Relight the three stabilizers, breach the sealed core chamber, and break Vharos, the Ashen Castellan, before he extinguishes Relay Zero.",
              "returnText": "Vharos is broken. The Relay Core beats like a buried heart, and his Ashen Heart still carries forbidden strength. Return the Core to the transmitter.",
              "completionText": "The transmitter answers. Avarra's last signal cuts through the ash, the Ashen Heart burns in your chest, and something distant answers in return."
            },
            "avarra.persistence.flags": {
              "schemaVersion": 1,
              "flags": {"signal.transmitted": false}
            }
          }
        },
