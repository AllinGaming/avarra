              "completionFlagKey": "echo.bound",
              "completionLabel": "Echo Shard bound"
            },
            "avarra.story.mission_narrative": {
              "schemaVersion": 1,
              "title": "The Answering Dark",
              "openingText": "Relay Zero's signal has drawn a hunter from beneath the eastern vault. Destroy Nhal, the Signal-Eater, and recover the Echo Shard it swallowed.",
              "returnText": "Nhal is dead. The Echo Shard repeats a voice from beyond Ashfall. Carry it to the listening shrine before the signal fades.",
              "completionText": "The shrine translates the echo into a path: Kharos, drowned beneath black water. The Vanguard leaves Relay Zero with a destination, and something ancient now knows their name."
            },
            "avarra.persistence.flags": {
              "schemaVersion": 1,
              "flags": {"echo.bound": false}
            }
          }
        }
